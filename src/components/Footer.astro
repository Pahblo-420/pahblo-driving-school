---
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const quickLinks = [
  { name: 'Home', path: '/' },
  { name: 'Services & Pricing', path: '/services' },
  { name: 'Our Fleet', path: '/fleet' },
  { name: 'Learners Resources', path: '/resources' },
  { name: 'Contact Us', path: '/contact' }
];
---

<footer class="bg-slate-950 text-slate-300 border-t-4 border-slate-900 relative mt-auto">
  {/* Premium Gradient Top Accent */}
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-600 via-amber-500 to-green-500"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      
      {/* Brand Column */}
      <div class="space-y-4">
        <h3 class="text-2xl font-black text-white uppercase tracking-wider italic">
          Pahblo <span class="text-amber-500">Driving</span>
        </h3>
        <p class="text-slate-400 text-sm leading-relaxed font-medium pr-4">
          Professional, patient, and K53-certified driving instruction in Phuthaditjhaba and the greater QwaQwa region.
        </p>
        <div class="flex space-x-4 pt-2">
          {/* Facebook */}
          <a href="#" aria-label="Facebook" class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-slate-400 hover:bg-blue-600 hover:text-white hover:-translate-y-1 transition-all duration-300">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          {/* X (Twitter) */}
          <a href="#" aria-label="X (formerly Twitter)" class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-slate-400 hover:bg-white hover:text-black hover:-translate-y-1 transition-all duration-300">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
          {/* TikTok */}
          <a href="#" aria-label="TikTok" class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-slate-400 hover:bg-pink-600 hover:text-white hover:-translate-y-1 transition-all duration-300">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
          </a>
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h4 class="text-white font-black uppercase tracking-widest mb-6 text-sm">Quick Links</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => {
            const isActive = currentPath === link.path || currentPath === `${link.path}/`;
            
            return (
              <li>
                <a 
                  href={link.path} 
                  class={`text-sm font-medium transition-colors flex items-center group ${isActive ? 'text-amber-500' : 'text-slate-300 hover:text-amber-500'}`}
                >
                  <span class={`w-1.5 h-1.5 rounded-full mr-3 transition-all ${isActive ? 'bg-amber-500 scale-150' : 'bg-slate-700 group-hover:bg-amber-500 group-hover:scale-150'}`}></span>
                  {link.name}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      {/* Contact Info */}
      <div>
        <h4 class="text-white font-black uppercase tracking-widest mb-6 text-sm">Get in Touch</h4>
        <ul class="space-y-4">
          <li class="flex items-start group">
            <div class="bg-slate-900 p-2 rounded mr-3 group-hover:bg-red-900/30 transition-colors">
              <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-sm font-medium mt-1">Phuthaditjhaba, 9866<br/>Free State</span>
          </li>
          <li class="flex items-center group">
            <div class="bg-slate-900 p-2 rounded mr-3 group-hover:bg-green-900/30 transition-colors">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <a href="tel:+27000000000" class="text-sm font-medium hover:text-green-400 transition-colors">082 000 0000</a>
          </li>
          <li class="flex items-center group">
            <div class="bg-slate-900 p-2 rounded mr-3 group-hover:bg-green-900/30 transition-colors">
              <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01a1.08 1.08 0 00-.788.371c-.271.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <a href="https://wa.me/27000000000" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:text-green-400 transition-colors">Chat on WhatsApp</a>
          </li>
          <li class="flex items-center group">
            <div class="bg-slate-900 p-2 rounded mr-3 group-hover:bg-amber-900/30 transition-colors">
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <a href="mailto:info@pahblo-driving.co.za" class="text-sm font-medium hover:text-amber-400 transition-colors">info@pahblo-driving.co.za</a>
          </li>
        </ul>
      </div>

      {/* Business Hours */}
      <div>
        <h4 class="text-white font-black uppercase tracking-widest mb-6 text-sm">Operating Hours</h4>
        <ul class="space-y-3 text-sm font-medium">
          <li class="flex justify-between border-b border-slate-800 pb-2">
            <span class="text-slate-400">Monday - Friday</span>
            <span class="text-white">07:00 - 17:00</span>
          </li>
          <li class="flex justify-between border-b border-slate-800 pb-2">
            <span class="text-slate-400">Saturday</span>
            <span class="text-white">08:00 - 14:00</span>
          </li>
          <li class="flex justify-between pb-2">
            <span class="text-slate-400">Sunday</span>
            <span class="text-red-500 font-bold uppercase tracking-wider text-xs flex items-center">Closed</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  {/* Copyright Bar */}
  <div class="border-t border-slate-900 bg-black/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col md:flex-row items-center justify-between">
      <p class="text-xs font-medium text-slate-400 mb-4 md:mb-0">
        &copy; {currentYear} Pahblo Driving School. All rights reserved.
      </p>
      <p class="text-xs font-medium text-slate-400 flex items-center">
        Website by 
        <a href="https://techpointweb.co.za" target="_blank" rel="noopener noreferrer" class="ml-1.5 text-slate-300 hover:text-amber-500 transition-colors font-black uppercase tracking-widest">
          TechPoint
        </a>
      </p>
    </div>
  </div>
</footer>