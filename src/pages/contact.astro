---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact & Booking - Pahblo Driving School">

  {/* 1. HERO HEADER */}
  <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,_var(--tw-gradient-stops))] from-slate-800 via-slate-900 to-slate-900"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center drop-shadow-xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800/50 border border-slate-700 text-xs font-black uppercase tracking-widest text-green-400 mb-6 backdrop-blur-sm">
        Start Your Engine
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight italic mb-6">
        Get in <span class="text-amber-500">Touch</span>
      </h1>
      <p class="mt-4 text-xl text-slate-300 max-w-2xl mx-auto font-medium">
        Ready to book your first lesson or have questions about the K53 test? Reach out to our team in Phuthaditjhaba today.
      </p>
    </div>
  </section>

  {/* 2. CONTACT LAYOUT */}
  <section class="pt-24 pb-12 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid lg:grid-cols-2 gap-16">
        
        {/* LEFT COLUMN: Contact Info */}
        <div>
          <h2 class="text-3xl font-black text-slate-900 uppercase italic mb-8">We are here to <span class="text-amber-500">help</span></h2>
          
          <div class="space-y-8 mb-12">
            {/* WhatsApp / Phone */}
            <div class="flex items-start gap-4 group">
              <div class="w-14 h-14 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-green-600 group-hover:text-white transition-colors duration-300">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <h4 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-1">Call or WhatsApp</h4>
                <a href="https://wa.me/27000000000" class="text-xl font-bold text-slate-900 hover:text-green-600 transition-colors">
                  +27 (0) 00 000 0000
                </a>
              </div>
            </div>

            {/* Email */}
            <div class="flex items-start gap-4 group">
              <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-amber-500 group-hover:text-white transition-colors duration-300">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h4 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-1">Email Us</h4>
                <a href="mailto:info@pahblodriving.co.za" class="text-xl font-bold text-slate-900 hover:text-amber-600 transition-colors">
                  info@pahblodriving.co.za
                </a>
              </div>
            </div>

            {/* Address */}
            <div class="flex items-start gap-4 group">
              <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-red-600 group-hover:text-white transition-colors duration-300">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <h4 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-1">Main Office</h4>
                <p class="text-lg font-bold text-slate-900">
                  Phuthaditjhaba (QwaQwa)<br />
                  <span class="text-base font-medium text-slate-600">Free State, South Africa</span>
                </p>
              </div>
            </div>
          </div>

          {/* Operating Hours Box */}
          <div class="bg-slate-900 rounded-3xl p-8 text-white shadow-xl">
            <h3 class="text-xl font-black uppercase italic mb-6 border-b border-slate-700 pb-4">Operating Hours</h3>
            <ul class="space-y-3 font-medium text-slate-300">
              <li class="flex justify-between items-center">
                <span>Monday - Friday</span>
                <span class="text-amber-400 font-bold">07:00 - 17:00</span>
              </li>
              <li class="flex justify-between items-center">
                <span>Saturday</span>
                <span class="text-amber-400 font-bold">08:00 - 14:00</span>
              </li>
              <li class="flex justify-between items-center text-slate-500">
                <span>Sunday & Public Holidays</span>
                <span>Closed</span>
              </li>
            </ul>
          </div>
        </div>

        {/* RIGHT COLUMN: The Form */}
        <div class="bg-white p-8 md:p-10 rounded-3xl border border-slate-200 shadow-2xl shadow-slate-200/50">
          <h3 class="text-2xl font-black text-slate-900 uppercase italic mb-6">Book a <span class="text-green-500">Lesson</span></h3>
          
          <form action="#" method="POST" class="space-y-6">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {/* First Name */}
              <div>
                <label for="firstName" class="block text-sm font-bold text-slate-700 mb-2">First Name *</label>
                <input type="text" id="firstName" name="firstName" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all text-slate-900 placeholder:text-slate-400" placeholder="John" />
              </div>
              
              {/* Last Name */}
              <div>
                <label for="lastName" class="block text-sm font-bold text-slate-700 mb-2">Last Name *</label>
                <input type="text" id="lastName" name="lastName" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all text-slate-900 placeholder:text-slate-400" placeholder="Doe" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {/* Phone */}
              <div>
                <label for="phone" class="block text-sm font-bold text-slate-700 mb-2">Phone Number *</label>
                <input type="tel" id="phone" name="phone" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all text-slate-900 placeholder:text-slate-400" placeholder="071 234 5678" />
              </div>
              
              {/* Service Required */}
              <div>
                <label for="service" class="block text-sm font-bold text-slate-700 mb-2">I am interested in... *</label>
                <select id="service" name="service" required class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all text-slate-900 appearance-none">
                  <option value="" disabled selected>Select an option</option>
                  <option value="learner">Learner's License Classes</option>
                  <option value="code8">Code 8 Driver's Training</option>
                  <option value="code10">Code 10 Driver's Training</option>
                  <option value="code14">Code 14 Driver's Training</option>
                  <option value="other">General Inquiry</option>
                </select>
              </div>
            </div>

            {/* Message */}
            <div>
              <label for="message" class="block text-sm font-bold text-slate-700 mb-2">Message (Optional)</label>
              <textarea id="message" name="message" rows="4" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all text-slate-900 placeholder:text-slate-400 resize-none" placeholder="Tell us about your driving experience or preferred lesson times..."></textarea>
            </div>

            {/* Submit Button */}
            <button type="submit" class="w-full py-4 px-8 rounded-xl font-black text-slate-900 uppercase tracking-widest bg-amber-500 hover:bg-amber-400 shadow-xl shadow-amber-500/30 transition-all duration-300">
              Send Message
            </button>
            <p class="text-xs text-center text-slate-500 mt-4">We usually respond within a few hours during business days.</p>
          </form>
        </div>

      </div>
    </div>
  </section>

  {/* 3. LOCATION MAP */}
  <section class="pb-24 pt-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="w-full h-[450px] bg-slate-200 rounded-3xl overflow-hidden border border-slate-200 shadow-xl relative group">
        {/* We use a generic Google Maps Embed API URL centered on Phuthaditjhaba */}
        <iframe 
          src="https://maps.google.com/maps?q=Phuthaditjhaba,+Free+State,+South+Africa&t=&z=13&ie=UTF8&iwloc=&output=embed" 
          class="w-full h-full border-0 absolute inset-0 transition-opacity duration-500" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

</BaseLayout>