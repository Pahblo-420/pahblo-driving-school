---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  {/* Hero Section */}
  <section class="bg-slate-900 relative overflow-hidden border-b-8 border-amber-500">
    {/* Decorative background element */}
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-red-600 via-slate-900 to-slate-900"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 lg:pt-32 lg:pb-36 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white tracking-tighter mb-6 uppercase italic">
          Learn. Drive. <span class="text-red-600">Succeed.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed font-medium max-w-2xl mx-auto">
          Professional, patient driving lessons in Phuthaditjhaba and the greater QwaQwa area. Master the K53 in our dual-controlled vehicles.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a 
            href="https://wa.me/27820000000" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-10 py-4 text-lg font-black uppercase tracking-wider text-slate-900 bg-green-500 rounded-md shadow-[0_0_15px_rgba(34,197,94,0.5)] hover:bg-green-400 hover:shadow-[0_0_25px_rgba(34,197,94,0.7)] hover:-translate-y-1 transition-all duration-300"
          >
            Start Learning
          </a>
          <a 
            href="/services" 
            class="w-full sm:w-auto px-10 py-4 text-lg font-black uppercase tracking-wider text-white bg-transparent border-2 border-amber-500 rounded-md hover:bg-amber-500 hover:text-slate-900 hover:-translate-y-1 transition-all duration-300"
          >
            View Packages
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Why Us / Features Grid */}
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-slate-900 uppercase tracking-tight italic">The Pahblo <span class="text-red-600">Standard</span></h2>
        <div class="h-1 w-24 bg-amber-500 mx-auto mt-4 rounded-full"></div>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {/* Feature 1 - Red Hover */}
        <div class="bg-white p-8 rounded-xl shadow-md border-b-4 border-transparent hover:border-red-600 hover:-translate-y-2 hover:shadow-xl transition-all duration-300 group">
          <div class="w-14 h-14 bg-slate-900 text-red-500 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-slate-900 mb-3 uppercase tracking-wide">Dual-Controlled</h3>
          <p class="text-slate-600 font-medium">Nervous? Don't be. Our vehicles are fitted with dual-controls so your instructor can step in instantly to keep you safe.</p>
        </div>

        {/* Feature 2 - Amber Hover */}
        <div class="bg-white p-8 rounded-xl shadow-md border-b-4 border-transparent hover:border-amber-500 hover:-translate-y-2 hover:shadow-xl transition-all duration-300 group">
          <div class="w-14 h-14 bg-slate-900 text-amber-500 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-slate-900 mb-3 uppercase tracking-wide">Certified Tutors</h3>
          <p class="text-slate-600 font-medium">Patient, professional, and fully certified. We focus on teaching you how to drive safely, not just how to pass a test.</p>
        </div>

        {/* Feature 3 - Green Hover */}
        <div class="bg-white p-8 rounded-xl shadow-md border-b-4 border-transparent hover:border-green-500 hover:-translate-y-2 hover:shadow-xl transition-all duration-300 group">
          <div class="w-14 h-14 bg-slate-900 text-green-500 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-slate-900 mb-3 uppercase tracking-wide">High Pass Rates</h3>
          <p class="text-slate-600 font-medium">Our structured lesson plans cover every aspect of the yard and road test, ensuring you walk into the DLTC fully prepared.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Quick Services Snapshot */}
  <section class="py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl font-black text-slate-900 mb-8 uppercase tracking-tight italic">Ready for the <span class="text-amber-500">Road?</span></h2>
          <ul class="space-y-6">
            <li class="flex items-start group">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold mr-4 group-hover:bg-red-600 group-hover:text-white transition-colors">1</span>
              <p class="text-slate-700 text-lg"><strong class="text-slate-900 font-black uppercase tracking-wide block mb-1">Code 8 Manual</strong> Traditional lessons covering clutch control, incline starts, and all K53 yard maneuvers.</p>
            </li>
            <li class="flex items-start group">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center font-bold mr-4 group-hover:bg-amber-500 group-hover:text-white transition-colors">2</span>
              <p class="text-slate-700 text-lg"><strong class="text-slate-900 font-black uppercase tracking-wide block mb-1">Code 8 Automatic</strong> Stress-free learning without the hassle of gears. Perfect for nervous beginners.</p>
            </li>
            <li class="flex items-start group">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center font-bold mr-4 group-hover:bg-green-500 group-hover:text-white transition-colors">3</span>
              <p class="text-slate-700 text-lg"><strong class="text-slate-900 font-black uppercase tracking-wide block mb-1">Car Hire for Tests</strong> Use the exact car you trained in for your final practical test at the traffic department.</p>
            </li>
          </ul>
          <div class="mt-10">
            <a href="/services" class="inline-flex items-center text-lg font-black uppercase tracking-wide text-red-600 hover:text-red-700 group">
              See all packages & pricing 
              <span class="ml-2 transform group-hover:translate-x-2 transition-transform">→</span>
            </a>
          </div>
        </div>
        
        {/* Placeholder for an image of the car or instructor */}
        <div class="bg-slate-900 aspect-video rounded-xl flex flex-col items-center justify-center overflow-hidden border-4 border-slate-800 shadow-2xl relative group">
          <div class="absolute inset-0 bg-red-600 opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          <svg class="w-16 h-16 text-slate-700 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <p class="text-slate-500 font-bold uppercase tracking-widest text-sm text-center px-4">Add an image of your fleet here in /public</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>