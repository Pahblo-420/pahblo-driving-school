---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/services-hero.png';
---

<BaseLayout title="Services & Pricing | Pahblo Driving School">
  
  {/* 1. HERO HEADER */}
  <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img 
        src={heroImage.src} 
        alt="Pahblo Driving School Services" 
        class="w-full h-full object-cover"
      />
      {/* Dark overlay that fades down into the light slate-50 background of the pricing grid */}
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/50 to-slate-50"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center drop-shadow-xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight italic mb-6">
        <span class="text-red-600">Our</span> <span class="text-amber-500">Packages</span> & <span class="text-green-500">Pricing</span>
      </h1>
      <p class="mt-4 text-xl text-slate-100 max-w-2xl mx-auto font-medium drop-shadow-md">
        Transparent pricing with no hidden fees. Choose the K53 training package that fits your journey to the open road.
      </p>
    </div>
  </section>

  {/* 2. PRICING GRID */}
  <section class="py-24 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="grid lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        
        {/* PACKAGE 1: Learner's License (Green) */}
        <div class="bg-white rounded-2xl border border-slate-200 flex flex-col relative overflow-hidden group hover:-translate-y-2 transition-all duration-300 shadow-lg hover:shadow-xl">
          <div class="h-2 w-full bg-green-500 absolute top-0 left-0"></div>
          <div class="p-8 pb-0">
            <h3 class="text-xl font-black text-slate-900 uppercase tracking-wider mb-2">Learner's License</h3>
            <p class="text-slate-500 text-sm font-medium mb-6">Perfect for absolute beginners starting their journey.</p>
            <div class="flex items-baseline mb-8">
              <span class="text-3xl font-bold text-slate-900 mr-2">R</span>
              <span class="text-5xl font-black text-slate-900 tracking-tight">350</span>
              <span class="text-slate-500 ml-2 font-medium">/ package</span>
            </div>
          </div>
          <div class="flex-grow p-8 pt-0 flex flex-col justify-between">
            <ul class="space-y-4 mb-8">
              {['Comprehensive K53 study materials', 'Mock test evaluations', 'Test booking assistance', 'Eye test guidance'].map((feature) => (
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                  <span class="text-slate-600 font-medium text-sm">{feature}</span>
                </li>
              ))}
            </ul>
            {/* Changed href to /contact */}
            <a href="/contact" class="w-full inline-flex justify-center items-center py-4 px-6 rounded-lg text-sm font-black uppercase tracking-widest text-green-700 bg-green-50 border border-green-200 hover:bg-green-500 hover:text-white hover:border-green-500 transition-colors duration-300">
              Book Now
            </a>
          </div>
        </div>

        {/* PACKAGE 2: Code 8 (Amber) - MOST POPULAR */}
        <div class="bg-white rounded-2xl border-2 border-amber-500 flex flex-col relative overflow-hidden group hover:-translate-y-2 transition-all duration-300 shadow-xl transform md:scale-105 z-10">
          <div class="bg-amber-500 text-slate-900 text-xs font-black uppercase tracking-widest py-1.5 text-center">
            Most Popular
          </div>
          <div class="p-8 pb-0">
            <h3 class="text-xl font-black text-slate-900 uppercase tracking-wider mb-2">Code 8 (B / EB)</h3>
            <p class="text-slate-500 text-sm font-medium mb-6">Manual or Automatic light motor vehicle training.</p>
            <div class="flex items-baseline mb-8">
              <span class="text-3xl font-bold text-slate-900 mr-2">R</span>
              <span class="text-5xl font-black text-slate-900 tracking-tight">2,500</span>
              <span class="text-slate-500 ml-2 font-medium">/ 10 lessons</span>
            </div>
          </div>
          <div class="flex-grow p-8 pt-0 flex flex-col justify-between">
            <ul class="space-y-4 mb-8">
              {['10 x 1 Hour practical driving lessons', 'Full K53 yard & road test preparation', 'Vehicle hire for the test day included', 'Free pick-up & drop-off in QwaQwa', 'Pre-test route familiarization'].map((feature) => (
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-amber-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                  <span class="text-slate-700 font-medium text-sm">{feature}</span>
                </li>
              ))}
            </ul>
            {/* Changed href to /contact */}
            <a href="/contact" class="w-full inline-flex justify-center items-center py-4 px-6 rounded-lg text-sm font-black uppercase tracking-widest text-slate-900 bg-amber-500 hover:bg-amber-400 shadow-[0_4px_14px_rgba(245,158,11,0.3)] transition-all duration-300">
              Book Now
            </a>
          </div>
        </div>

        {/* PACKAGE 3: Code 10 & 14 (Red) */}
        <div class="bg-white rounded-2xl border border-slate-200 flex flex-col relative overflow-hidden group hover:-translate-y-2 transition-all duration-300 shadow-lg hover:shadow-xl">
          <div class="h-2 w-full bg-red-600 absolute top-0 left-0"></div>
          <div class="p-8 pb-0">
            <h3 class="text-xl font-black text-slate-900 uppercase tracking-wider mb-2">Code 10 & 14</h3>
            <p class="text-slate-500 text-sm font-medium mb-6">Heavy motor vehicle and extra heavy commercial.</p>
            <div class="flex items-baseline mb-8">
              <span class="text-3xl font-bold text-slate-900 mr-2">R</span>
              <span class="text-5xl font-black text-slate-900 tracking-tight">5,500</span>
              <span class="text-slate-500 ml-2 font-medium">/ 10 lessons</span>
            </div>
          </div>
          <div class="flex-grow p-8 pt-0 flex flex-col justify-between">
            <ul class="space-y-4 mb-8">
              {['10 x 1 Hour heavy vehicle lessons', 'Specialized K53 yard maneuvering', 'Vehicle hire for the test day included', 'Focus on commercial driving safety'].map((feature) => (
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-red-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                  <span class="text-slate-600 font-medium text-sm">{feature}</span>
                </li>
              ))}
            </ul>
            {/* Changed href to /contact */}
            <a href="/contact" class="w-full inline-flex justify-center items-center py-4 px-6 rounded-lg text-sm font-black uppercase tracking-widest text-red-700 bg-red-50 border border-red-200 hover:bg-red-600 hover:text-white hover:border-red-600 transition-colors duration-300">
              Book Now
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* 3. ADD-ONS & HOURLY RATES */}
  <section class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Section Header */}
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 border-b border-slate-200 pb-8">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-5xl font-black text-slate-900 uppercase tracking-tight italic mb-4">
            Individual Lessons <span class="text-slate-400">& Add-ons</span>
          </h2>
          <p class="text-lg text-slate-600 font-medium">
            Not looking for a full package? Build your own curriculum or grab a quick refresher with our individual services.
          </p>
        </div>
        <div class="hidden md:block">
          {/* Updated Pill: Green text and green border */}
          <div class="px-6 py-3 bg-green-50 rounded-full text-sm font-bold text-green-600 uppercase tracking-widest border border-green-500">
            Pay as you go
          </div>
        </div>
      </div>

      {/* 2-Column Menu Layout */}
      <div class="grid lg:grid-cols-2 gap-6">
        
        {/* Add-on 1: Code 8 (Amber Borders) */}
        <a href="/contact" class="group flex flex-col sm:flex-row sm:items-center justify-between p-6 rounded-2xl bg-slate-50 border border-amber-300 hover:bg-white hover:border-amber-500 hover:shadow-[0_8px_30px_rgb(245,158,11,0.12)] transition-all duration-300">
          <div class="flex items-center gap-6 mb-4 sm:mb-0">
            <div class="w-14 h-14 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 22a10 10 0 0 1-10-10H2 M12 22a10 10 0 0 0 10-10h-2 M12 2a10 10 0 0 1 10 10h-2 M12 2a10 10 0 0 0-10 10H2"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-amber-600 transition-colors">Code 8 Lesson</h4>
              <p class="text-slate-500 text-sm font-medium">1 Hour practical driving</p>
            </div>
          </div>
          <div class="flex items-center justify-between sm:block border-t sm:border-t-0 border-amber-100 sm:border-transparent pt-4 sm:pt-0">
            <div class="text-right">
              <span class="text-lg font-bold text-slate-400 mr-1">R</span>
              <span class="text-3xl font-black text-slate-900">250</span>
            </div>
            <div class="sm:hidden text-amber-500 font-bold text-sm uppercase tracking-wider">Book &rarr;</div>
          </div>
        </a>

        {/* Add-on 2: Code 10 (Red Borders) */}
        <a href="/contact" class="group flex flex-col sm:flex-row sm:items-center justify-between p-6 rounded-2xl bg-slate-50 border border-red-300 hover:bg-white hover:border-red-500 hover:shadow-[0_8px_30px_rgb(220,38,38,0.12)] transition-all duration-300">
          <div class="flex items-center gap-6 mb-4 sm:mb-0">
            <div class="w-14 h-14 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h10M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2M8 7H5a2 2 0 00-2 2v8a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3M6 19v2a1 1 0 001 1h2a1 1 0 001-1v-2m8 0v2a1 1 0 001 1h2a1 1 0 001-1v-2"></path></svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-red-600 transition-colors">Code 10 Lesson</h4>
              <p class="text-slate-500 text-sm font-medium">1 Hour heavy vehicle</p>
            </div>
          </div>
          <div class="flex items-center justify-between sm:block border-t sm:border-t-0 border-red-100 sm:border-transparent pt-4 sm:pt-0">
            <div class="text-right">
              <span class="text-lg font-bold text-slate-400 mr-1">R</span>
              <span class="text-3xl font-black text-slate-900">350</span>
            </div>
            <div class="sm:hidden text-red-500 font-bold text-sm uppercase tracking-wider">Book &rarr;</div>
          </div>
        </a>

        {/* Add-on 3: Car Hire (Green Borders) */}
        <a href="/contact" class="group flex flex-col sm:flex-row sm:items-center justify-between p-6 rounded-2xl bg-slate-50 border border-green-300 hover:bg-white hover:border-green-500 hover:shadow-[0_8px_30px_rgb(34,197,94,0.12)] transition-all duration-300">
          <div class="flex items-center gap-6 mb-4 sm:mb-0">
            <div class="w-14 h-14 rounded-full bg-green-100 text-green-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-green-600 transition-colors">Test Day Car Hire</h4>
              <p class="text-slate-500 text-sm font-medium">Vehicle use for the road test</p>
            </div>
          </div>
          <div class="flex items-center justify-between sm:block border-t sm:border-t-0 border-green-100 sm:border-transparent pt-4 sm:pt-0">
            <div class="text-right">
              <span class="text-lg font-bold text-slate-400 mr-1">R</span>
              <span class="text-3xl font-black text-slate-900">600</span>
            </div>
            <div class="sm:hidden text-green-500 font-bold text-sm uppercase tracking-wider">Book &rarr;</div>
          </div>
        </a>

        {/* Add-on 4: Shuttle (Slate Borders) */}
        <a href="/contact" class="group flex flex-col sm:flex-row sm:items-center justify-between p-6 rounded-2xl bg-slate-50 border border-slate-300 hover:bg-white hover:border-slate-500 hover:shadow-[0_8px_30px_rgb(100,116,139,0.12)] transition-all duration-300">
          <div class="flex items-center gap-6 mb-4 sm:mb-0">
            <div class="w-14 h-14 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-slate-700 transition-colors">Traffic Dept Shuttle</h4>
              <p class="text-slate-500 text-sm font-medium">Return trip for bookings/eyes</p>
            </div>
          </div>
          <div class="flex items-center justify-between sm:block border-t sm:border-t-0 border-slate-200 sm:border-transparent pt-4 sm:pt-0">
            <div class="text-right">
              <span class="text-lg font-bold text-slate-400 mr-1">R</span>
              <span class="text-3xl font-black text-slate-900">150</span>
            </div>
            <div class="sm:hidden text-slate-600 font-bold text-sm uppercase tracking-wider">Book &rarr;</div>
          </div>
        </a>

      </div>
    </div>
  </section>

  {/* 4. K53 PROCESS TIMELINE */}
  <section class="py-24 bg-slate-50 border-t border-slate-200 overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Section Header */}
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 uppercase tracking-tight italic mb-4">
          The <span class="text-slate-400">K53</span> Journey
        </h2>
        <p class="text-lg text-slate-600 font-medium max-w-2xl mx-auto">
          Your step-by-step roadmap to getting your South African driver's license safely, legally, and confidently.
        </p>
      </div>

      {/* Timeline Container */}
      <div class="relative">
        
        {/* Continuous Vertical Line Track */}
        <div class="absolute left-6 md:left-10 top-2 bottom-2 w-1 bg-slate-200 rounded-full z-0">
          {/* Animated Moving Light */}
          <div class="absolute left-1/2 -translate-x-1/2 w-1.5 h-24 rounded-full moving-light-anim z-10"></div>
        </div>

        <div class="space-y-12">
          
          {/* STEP 1: Learner's (Green) */}
          <div class="relative z-20 flex items-start group">
            <div class="flex-shrink-0 w-12 h-12 md:w-20 md:h-20 rounded-full bg-white border-4 border-green-500 shadow-md flex items-center justify-center mr-6 md:mr-10 group-hover:scale-110 group-hover:bg-green-50 transition-all duration-300">
              <span class="text-xl md:text-3xl font-black text-green-600">1</span>
            </div>
            <div class="flex-grow bg-white border border-slate-200 p-6 md:p-8 rounded-2xl shadow-sm group-hover:border-green-300 group-hover:shadow-md transition-all duration-300">
              <h3 class="text-xl md:text-2xl font-black text-slate-900 uppercase tracking-wider mb-2">Get Your Learner's</h3>
              <p class="text-slate-600 font-medium leading-relaxed mb-4">
                Before getting behind the wheel, you must pass the computer-based theory test covering road signs, rules of the road, and vehicle controls.
              </p>
              <ul class="text-sm text-slate-500 space-y-2 font-medium">
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-2"></span> Book at a DLTC</li>
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-2"></span> Study our comprehensive materials</li>
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-2"></span> Pass the multiple-choice test</li>
              </ul>
            </div>
          </div>

          {/* STEP 2: Booking (Amber) */}
          <div class="relative z-20 flex items-start group">
            <div class="flex-shrink-0 w-12 h-12 md:w-20 md:h-20 rounded-full bg-white border-4 border-amber-500 shadow-md flex items-center justify-center mr-6 md:mr-10 group-hover:scale-110 group-hover:bg-amber-50 transition-all duration-300">
              <span class="text-xl md:text-3xl font-black text-amber-500">2</span>
            </div>
            <div class="flex-grow bg-white border border-slate-200 p-6 md:p-8 rounded-2xl shadow-sm group-hover:border-amber-300 group-hover:shadow-md transition-all duration-300">
              <h3 class="text-xl md:text-2xl font-black text-slate-900 uppercase tracking-wider mb-2">Book Your Test Date</h3>
              <p class="text-slate-600 font-medium leading-relaxed mb-4">
                Secure your test date early. We assist with booking dates and arranging transport to the traffic department for eye tests and confirmations.
              </p>
              <ul class="text-sm text-slate-500 space-y-2 font-medium">
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-2"></span> Complete your eye test</li>
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-2"></span> Pay traffic department fees</li>
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-2"></span> Lock in your practical exam date</li>
              </ul>
            </div>
          </div>

          {/* STEP 3: Practical Training (Red) */}
          <div class="relative z-20 flex items-start group">
            <div class="flex-shrink-0 w-12 h-12 md:w-20 md:h-20 rounded-full bg-white border-4 border-red-500 shadow-md flex items-center justify-center mr-6 md:mr-10 group-hover:scale-110 group-hover:bg-red-50 transition-all duration-300">
              <span class="text-xl md:text-3xl font-black text-red-600">3</span>
            </div>
            <div class="flex-grow bg-white border border-slate-200 p-6 md:p-8 rounded-2xl shadow-sm group-hover:border-red-300 group-hover:shadow-md transition-all duration-300">
              <h3 class="text-xl md:text-2xl font-black text-slate-900 uppercase tracking-wider mb-2">Practical Training</h3>
              <p class="text-slate-600 font-medium leading-relaxed mb-4">
                Hit the road with our patient instructors. We'll perfect your pre-trip inspections, yard maneuvers (parking, alley docking), and road driving.
              </p>
              <ul class="text-sm text-slate-500 space-y-2 font-medium">
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-2"></span> Master pre-trip exterior & interior</li>
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-2"></span> Perfect yard maneuvers</li>
                <li class="flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-2"></span> Navigate the official test routes safely</li>
              </ul>
            </div>
          </div>

          {/* STEP 4: The K53 Test (Dark/Finish Line) */}
          <div class="relative z-20 flex items-start group">
            <div class="flex-shrink-0 w-12 h-12 md:w-20 md:h-20 rounded-full bg-slate-900 border-4 border-slate-900 shadow-md flex items-center justify-center mr-6 md:mr-10 group-hover:scale-110 transition-all duration-300">
              <svg class="w-6 h-6 md:w-10 md:h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div class="flex-grow bg-slate-900 border border-slate-800 p-6 md:p-8 rounded-2xl shadow-lg group-hover:shadow-2xl transition-all duration-300">
              <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-wider mb-2">The Driving Test</h3>
              <p class="text-slate-300 font-medium leading-relaxed mb-4">
                Test day is here. Use our vehicle, execute what you've practiced, and pass your yard and road test to claim your driver's license.
              </p>
              <a href="/contact" class="inline-flex items-center mt-2 text-white font-black uppercase tracking-widest text-sm hover:text-amber-400 transition-colors">
                Start Your Journey <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <style>
    .moving-light-anim {
      animation: timeline-travel 5s linear infinite;
    }

    @keyframes timeline-travel {
      0% {
        top: 0%;
        background-color: #22c55e; /* Green */
        box-shadow: 0 0 16px 3px rgba(34, 197, 94, 0.7);
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      33% {
        background-color: #f59e0b; /* Amber */
        box-shadow: 0 0 16px 3px rgba(245, 158, 11, 0.7);
      }
      66% {
        background-color: #ef4444; /* Red */
        box-shadow: 0 0 16px 3px rgba(239, 68, 68, 0.7);
      }
      90% {
        opacity: 1;
      }
      100% {
        top: calc(100% - 6rem); /* Stops cleanly at the bottom */
        background-color: #0f172a; /* Slate 900 */
        box-shadow: 0 0 16px 3px rgba(15, 23, 42, 0.7);
        opacity: 0;
      }
    }
  </style>

  {/* 5. PREMIUM CTA SECTION */}
